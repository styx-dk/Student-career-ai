# Backend
APP_ENV=development
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_DOCUMENT_BUCKET=career-documents
SUPABASE_RESUME_BUCKET=generated-resumes
MAX_UPLOAD_MB=20

# AI providers
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Analysis weights (must total 1.0)
READINESS_SKILL_WEIGHT=0.55
READINESS_SEMANTIC_WEIGHT=0.20
READINESS_EVIDENCE_WEIGHT=0.25
FORECAST_HORIZON_MONTHS=6

# Frontend (copy relevant values to frontend/.env.local)
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=

